# Slack incoming webhook path after https://hooks.slack.com/services/
SLACK_TOKEN=your_slack_webhook_path_here
SLACK_CHANNEL=#your_slack_channel_here

# Menu Crawling Configuration
CRAWL_URL=https://eisodosirak.itpage.kr/bbs/board.php?bo_table=basic4

# Naver Clova OCR Configuration (Required for image processing)
CLOVA_URL=your_clova_api_url_here
CLOVA_SECRET_KEY=your_clova_secret_key_here

# Optional defense-in-depth for management endpoints (use a long random value)
ADMIN_TOKEN=replace_with_a_random_admin_token

# Runtime defaults (overridden by Docker Compose in production)
SERVER_PORT=8080
DB_FILE_DIR=./db
STATIC_DIR=./front/dist
